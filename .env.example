# Copy to .env (git-ignored) and export before running. Never commit real values.
# Leave everything unset to use the built-in SQLite demo database (microfinance.db).

# --- MySQL instead of SQLite ---
# DB_URL=jdbc:mysql://localhost:3306/microfinance?createDatabaseIfNotExist=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DIALECT=org.hibernate.dialect.MySQL5Dialect
# DB_POOL_SIZE=10
# DB_SEED=never

JPA_DDL_AUTO=update
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
